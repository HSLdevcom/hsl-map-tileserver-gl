      "pbfAlias": "pbf",
      "serveAllStyles": true,
      "serveAllFonts": true,
      "serveStaticMaps": false
    },
    "styles": {},
    "sources": {},
    "data": {
      "openmaptiles": {
        "mbtiles": "finland.mbtiles"
      }
    }
  }